        {
          "id": "eb82f2e5-a5f3-43a2-a85c-1ab0f35cb301",
          "name": "Take Snapshot",
          "request": {
            "name": "Take Snapshot",
            "description": {
              "content": "Description: Takes an on-demand snapshot of the specified resource.\n\nThis operation is asynchronous.\nIt triggers a backup job and returns a job ID, which can be used to track the progress of the backup job.\nYou can follow the progress of the backup job by calling [Get Backup Job](/api/api-reference/jobs/backup-jobs/get-backup-job) with the job ID.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "projects",
                ":projectId",
                "resources",
                ":id",
                "take-snapshot"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "projectId",
                  "description": "(Required) ID of the project the resource is in.\nYou can get your project ID from the [API Credentials](https://console.eon.io/global-management/api-credentials) page in your global management console.\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) Eon-assigned ID of the resource to back up."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"retentionDays\": \"<integer>\",\n  \"vaultId\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
